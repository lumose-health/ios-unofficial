# Provenance pin for the committed EC-JPAKE fixtures (SPK-2).
#
# The Android revision the fixtures in Tests/Fixtures/EcJpake/ were captured from.
# scripts/spk2/verify_vectors.sh creates its disposable worktree at exactly this
# commit, so regeneration does not follow the external checkout's mutable HEAD.
#
# Re-pinning is deliberate and never automatic: run
#   ANDROID_SHA=<new sha> bash scripts/spk2/verify_vectors.sh --update
# which rewrites the line below, and then update the provenance table in
# Tests/Fixtures/EcJpake/README.md in the same commit — validate_fixtures.py fails
# while the README and this file disagree.
ANDROID_SHA=59e68104df17614c50173bed954843a5f56e588b
